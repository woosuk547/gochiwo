// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ReservationSource {
  DIRECT
  PARTNERSHIP
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CORPORATE_BILLING
}

enum PaymentStatus {
  REVIEW_PENDING
  PAYMENT_GUIDE_SENT
  DEPOSIT_PAID
  PAID
  REFUNDED
}

model Reservation {
  id               String            @id @default(cuid())
  source           ReservationSource @default(DIRECT)
  status           ReservationStatus @default(PENDING)
  guestName        String
  companyName      String?
  email            String
  phone            String
  guests           Int
  checkIn          DateTime
  checkOut         DateTime
  arrivalTime      String?
  benefitLabel     String?
  paymentMethod    PaymentMethod     @default(CARD)
  paymentStatus    PaymentStatus     @default(REVIEW_PENDING)
  baseAmount       Int               @default(0)
  extraGuestAmount Int               @default(0)
  discountAmount   Int               @default(0)
  finalAmount      Int               @default(0)
  depositAmount    Int               @default(0)
  note             String?
  requestedAt      DateTime?
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime @unique
  label     String?
  createdAt DateTime @default(now())
}
